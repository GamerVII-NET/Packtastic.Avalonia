<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Packtastic.Avalonia.Desktop.ViewModels"
             xmlns:avalonia="clr-namespace:Packtastic.Avalonia;assembly=Packtastic.Avalonia.Interfaces"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Packtastic.Avalonia.Desktop.Views.ProjectPage"
             x:DataType="vm:PackWindowViewModel">

    <Grid ColumnDefinitions="*, 1, *, 1, *">
        <Border Grid.Column="0" Padding="15">
            <StackPanel>
                <TextBlock Text="Choice Solution"
                           FontWeight="Bold"
                           FontSize="16" />
                <Border IsVisible="{Binding SolutionsIsEmpty}" Margin="0, 20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Solutions not found." VerticalAlignment="Center" />
                        <HyperlinkButton Click="OpenDirectoryFolder" Content="Add directory" Margin="0, 10" />
                    </StackPanel>
                </Border>

                <ScrollViewer>
                    <ListBox ItemsSource="{Binding Solutions}"
                             SelectedItem="{Binding SelectedSolution}"
                             Margin="0, 10, 0, 0">
                        <ListBox.DataTemplates>
                            <DataTemplate x:DataType="avalonia:ISolution">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </ScrollViewer>
            </StackPanel>

        </Border>
        <Rectangle Grid.Column="1" Fill="#15000000"></Rectangle>

        <Border Grid.Column="2" Padding="15">
            <StackPanel>
                <TextBlock Text="Choice project"
                           FontWeight="Bold"
                           FontSize="16" />
                <Border IsVisible="{Binding ProjectsIsEmpty}" Margin="0, 20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Projects not found." VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding SolutionProjects}"
                         SelectedItem="{Binding SelectedProject}"
                         Margin="0, 10, 0, 0">
                    <ListBox.DataTemplates>
                        <DataTemplate x:DataType="avalonia:IProject">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
            </StackPanel>
        </Border>
        
        <Rectangle Grid.Column="3" Fill="#15000000"></Rectangle>
        
        <Border Grid.Column="4" Padding="15">
            <StackPanel>
                <TextBlock Text="Choice project"
                           FontWeight="Bold"
                           FontSize="16" />
                <Border IsVisible="{Binding BuildProjectsIsEmpty}" Margin="0, 20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Build projects not found." VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding BuildProjects}"
                         Margin="0, 10, 0, 0">
                    <ListBox.DataTemplates>
                        <DataTemplate x:DataType="avalonia:IProject">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
                <Button Command="{Binding CreateProjectCommand}"
                        Content="Add build project"/>
            </StackPanel>
        </Border>

        <ProgressBar Grid.Column="0"
                     Grid.ColumnSpan="5"
                     VerticalAlignment="Top"
                     IsIndeterminate="{Binding IsProcessing}" />
    </Grid>

</UserControl>